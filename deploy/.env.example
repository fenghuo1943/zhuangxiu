# ============================================================
#  小装家 · 群晖 NAS 部署配置
#  首次运行 ./deploy.sh 会自动复制本文件为 .env，并自动填入
#  群晖局域网 IP 和随机 JWT 密钥。
# ============================================================

# 站点访问地址（重要！前端构建时写死，修改后需重新 ./deploy.sh build）
# 留空表示使用相对路径，自动适配当前访问的域名（推荐，支持外网和内网访问）
VITE_API_BASE=

# 前端对外端口（群晖主机端口，映射到容器内 80）
WEB_PORT=8007

# HTTPS 对外端口（映射到容器内 443，需配置 SSL 证书到 certs 目录）
HTTPS_PORT=8008

# 后端对外端口（默认不暴露，仅容器内部访问；需要直连调试时放开注释）
# API_PORT=8003

# 数据库连接（复用现有 MySQL）
# 格式：mysql+aiomysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+aiomysql://renovation:Wzcx131130_@192.168.31.146:3307/renovation

# 时区（与群晖所在地一致，影响时间显示）
TZ=Asia/Shanghai

# JWT 密钥（首次部署会自动生成随机值；已有数据时改动会让旧登录失效，需重新登录一次）
JWT_SECRET=change-me
REFRESH_SECRET=change-me
